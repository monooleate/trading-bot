# EdgeCalc — .env template (Hetzner Docker co-host)
# ---------------------------------------------------------------------------
# Copy to `.env` on the server (chmod 600, root:edgecalc) and fill in real
# values. NEVER commit the real `.env`. This template carries NO secret values.
#
# Full catalog (61 vars, 13 groups) + every tuning knob and its code default:
#   internal-docs/current-state/env-vars.md  (SSOT)
# Only the SECRETS + infra + mode flags below MUST be set; all *_* tuning
# knobs (crypto/weather/HL/F-arb/sports sizing & thresholds) have safe
# defaults baked into the pillar config and are optional overrides.
# ===========================================================================

# ── Runtime mode ───────────────────────────────────────────────────────────
PAPER_MODE=true            # keep true until Phase 6 parity + explicit go-live
PAPER_NEVER_STOP=1         # paper safety valve (self-heal auto-stopped sessions)

# ── Postgres (NEW — Hetzner co-host, §18.2) ────────────────────────────────
# The edgecalc DB + user live in the existing umami postgres:17 container.
EDGECALC_DB_PASSWORD=      # strong password for the `edgecalc` DB user
DATABASE_URL=postgresql://edgecalc:${EDGECALC_DB_PASSWORD}@db:5432/edgecalc

# ── Auth (dashboard) ───────────────────────────────────────────────────────
JWT_SECRET=                # 32+ char random
AUTH_PASSWORD_HASH=        # sha256 of the dashboard password

# ── Hyperliquid (perp + funding-arb pillars) ───────────────────────────────
HL_PRIVATE_KEY=            # 0x + 64 hex
HL_WALLET_ADDRESS=         # 0x...

# ── Polymarket (crypto/weather/sports pillars) ─────────────────────────────
POLY_PRIVATE_KEY=          # 0x + 64 hex
POLY_FUNDER_ADDRESS=       # 0x... (proxy/funder wallet)
POLY_SIGNATURE_TYPE=       # 0 | 1 | 2 (Polymarket signature type)
POLYGON_RPC_URL=           # https://polygon-rpc.com or a provider URL

# ── Exchange keys (hedging / price feeds) ──────────────────────────────────
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ── LLM (arbmatrix / llm-dependency tool) ──────────────────────────────────
ANTHROPIC_API_KEY=         # sk-ant-...

# ── Telegram ops alerts ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional / not-blocking ────────────────────────────────────────────────
# ODDS_API_KEY=            # #9 sports Pinnacle de-vig feed (default-off knob)
