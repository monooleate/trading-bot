{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["packages/core/src/*"],
      "@worker/*": ["services/worker/src/*"],
      "@api/*": ["services/api/src/*"],
      "@netlify/blobs": ["packages/core/src/blobs-compat.ts"]
    }
  },
  "include": [
    "apps/web/src/**/*",
    "services/**/*",
    "packages/**/*"
  ]
}
