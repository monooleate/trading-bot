{
  "name": "edgecalc",
  "version": "1.0.0",
  "private": true,
  "description": "EdgeCalc monorepo — apps/web (Astro), services/{api,worker,feeds}, packages/core. Migrating Netlify+Blobs → Hetzner Docker co-host (Postgres). See internal-docs/roadmap/migration-runbook.md.",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "build:web": "npm --prefix apps/web run build",
    "preview": "npm --prefix apps/web run preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^3.6.0",
    "@astrojs/tailwind": "^5.1.0",
    "@electric-sql/pglite": "^0.5.8",
    "@netlify/blobs": "^8.2.0",
    "@netlify/functions": "^2.8.2",
    "@nktkas/hyperliquid": "^0.33.3",
    "@noble/hashes": "^2.0.1",
    "@polymarket/clob-client": "^5.8.1",
    "@polymarket/real-time-data-client": "^1.4.0",
    "@types/pg": "^8.23.1",
    "astro": "^4.16.0",
    "ccxt": "^4.5.43",
    "jose": "^6.2.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.47.12"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
